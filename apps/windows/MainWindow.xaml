<Window
    x:Class="Neto.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Neto">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            x:Name="TopHeaderBorder"
            Grid.Row="0"
            Padding="20,12,20,8"
            Visibility="Collapsed">
            <TextBlock
                x:Name="PageHeaderText"
                FontSize="18"
                FontWeight="SemiBold" />
        </Border>

        <Grid x:Name="ContentHost" Grid.Row="1" />

        <Border
            Grid.Row="2"
            Padding="12,8,12,10"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid x:Name="BottomNavGrid" ColumnSpacing="8" MaxWidth="640" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="NavConnectBtn" Grid.Column="0" HorizontalAlignment="Stretch" Tag="connect" Click="OnNavClick" Content="连接" />
                <Button x:Name="NavDashboardBtn" Grid.Column="1" HorizontalAlignment="Stretch" Tag="dashboard" Click="OnNavClick" Content="主页" />
                <Button x:Name="NavNodesBtn" Grid.Column="2" HorizontalAlignment="Stretch" Tag="nodes" Click="OnNavClick" Content="节点" />
                <Button x:Name="NavProfilesBtn" Grid.Column="3" HorizontalAlignment="Stretch" Tag="profiles" Click="OnNavClick" Content="订阅" />
                <Button x:Name="NavSettingsBtn" Grid.Column="4" HorizontalAlignment="Stretch" Tag="settings" Click="OnNavClick" Content="设置" />
            </Grid>
        </Border>
    </Grid>
</Window>
