<Window
    x:Class="Neto.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Neto">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            x:Name="TopHeaderBorder"
            Grid.Row="0"
            Visibility="Collapsed">
            <Grid MaxWidth="860" HorizontalAlignment="Stretch" Padding="18,10,18,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="PageHeaderText"
                    FontSize="16"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
                <ContentControl
                    x:Name="PageHeaderActionHost"
                    Grid.Column="1"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid x:Name="ContentHost" Grid.Row="1" />

        <Border
            Grid.Row="2"
            Padding="14,4,14,6"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <SelectorBar
                x:Name="BottomSelectorBar"
                HorizontalAlignment="Center"
                SelectionChanged="OnNavSelectionChanged">
                <SelectorBarItem x:Name="NavHomeItem" Tag="home" Text="主页">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="NavNodesItem" Tag="nodes" Text="节点">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE774;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="NavConnectionsItem" Tag="connections" Text="会话">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE8CB;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="NavRulesItem" Tag="rules" Text="规则">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="NavProfilesItem" Tag="profiles" Text="订阅">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE895;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="NavSettingsItem" Tag="settings" Text="设置">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>
        </Border>
    </Grid>
</Window>
